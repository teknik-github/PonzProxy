# Copy to .env next to docker-compose.yml and edit. Every setting is optional:
# an entry left out, or left empty, uses the default shown after it.
#
#   cp .env.example .env
#   docker compose up -d
#
# Settings live here rather than in docker-compose.yml so that replacing the
# compose file on an upgrade does not discard them. .env is gitignored.

# ---------------------------------------------------------------- the image --

# Pin the image rather than tracking latest for anything you care about. Every
# release tag has a matching image; CHANGELOG.md says what changed in each.
#PONZ_VERSION=0.4.0                       # default: latest

# ----------------------------------------------------------------- the ports --

# Proxied traffic. Change these only when something else already holds 80 and
# 443 — ACME HTTP-01 and TLS-ALPN-01 challenges are answered on them, and a
# certificate authority will only ever connect to the standard ports.
#PONZ_HTTP_PORT=80
#PONZ_HTTPS_PORT=443

# The console, the REST API and the WebSocket feed. Published to 127.0.0.1
# only, whatever this is set to. Do not expose it to the internet: a password
# is all that stands in front of it. Reach it over a VPN or an SSH tunnel.
#PONZ_CONSOLE_PORT=8080

# ------------------------------------------------------------------- Let's Encrypt --

# Where expiry warnings from the certificate authority are sent. Worth setting:
# it is how you find out about a renewal that has been failing quietly.
#PONZ_ACME_EMAIL=you@example.com

# Point at the staging CA while testing. Production issuance is rate limited
# per domain, and a failed experiment can lock you out of that domain for a
# week. Certificates from staging are not trusted by browsers, which is the
# point — it proves the challenge works without spending a real quota.
#PONZ_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# ------------------------------------------------------------ behind a proxy --

# Take the client IP from this header instead of the connection. Set it ONLY
# when ponzproxy sits behind a proxy you control that overwrites the header on
# every request, such as a Cloudflare Tunnel. Otherwise any client can forge
# it, which would let them choose their own backend under IP-hash routing and
# walk straight through an access list.
#PONZ_TRUSTED_PROXY_HEADER=CF-Connecting-IP

# ------------------------------------------------------------------ logging --

#PONZ_LOG_LEVEL=info                      # debug, info, warn, error
#PONZ_LOG_FORMAT=text                     # text, or json for a log aggregator

# --------------------------------------------------------------- backups --

# A snapshot of the data directory is written on this interval, and the newest
# PONZ_BACKUP_KEEP are retained. Set the interval to 0 to switch it off.
#
# These sit next to the data they copy. They protect you from a deleted host, a
# bad edit and a corrupted database — not from losing this machine. For that,
# copy them off the server:
#
#   ponzproxy --backup /tmp/ponzproxy.tar.gz && scp /tmp/ponzproxy.tar.gz elsewhere:
#
# An archive holds every private key, the ACME account key and the session
# secret. Treat it exactly as you would the server itself.
#PONZ_BACKUP_EVERY=24h
#PONZ_BACKUP_KEEP=7

# ------------------------------------------------------- retention and disk --

# How long an admin session stays valid before signing in again.
#PONZ_SESSION_TTL=24h

# The searchable request log is bounded by age and by row count, and the row
# cap is the one that makes the worst case predictable: age alone cannot stop a
# traffic burst from filling a disk. At 40 req/s, seven days is roughly 24
# million rows and 3.8 GB uncapped, against 78 MB at the default cap.
#PONZ_ACCESS_LOG_RETENTION=168h           # 7 days
#PONZ_ACCESS_LOG_MAX_ROWS=500000

# Historical charts. Samples are small — one row per active host per flush —
# so a long retention here costs far less than the access log.
#PONZ_METRICS_RETENTION=720h              # 30 days
